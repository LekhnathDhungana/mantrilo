# Optional verified public contact address, included in the browser bundle.
# When unset, the form only prepares a downloadable draft and sends nothing.
EXPO_PUBLIC_CONTACT_EMAIL=
# No production API is connected. Never add private API keys to EXPO_PUBLIC_*.

# Confirmed production HTTPS origin only, without a path. Leave blank for preview.
EXPO_PUBLIC_SITE_URL=
# Defaults to false. Only enable for an authorized production deployment.
EXPO_PUBLIC_INDEXING_ENABLED=false
