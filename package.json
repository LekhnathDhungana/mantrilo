{
  "name": "mantrilo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.26",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "i18next": "^27.2.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "scripts": {
    "start": "node scripts/i18n-build.mjs && expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/i18n-build.mjs && expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/i18n-build.mjs && expo export --platform web && node scripts/finalize-web.mjs",
    "preview": "node scripts/preview.mjs",
    "check:seo": "python3 scripts/check-seo.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:build": "node scripts/i18n-build.mjs",
    "i18n:check": "node scripts/i18n-check.mjs"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  }
}
