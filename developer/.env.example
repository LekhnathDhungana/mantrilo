# Local demo: loopback-only, no real accounts or live billing. Resets on restart.
MANTRILO_MODE=demo
MANTRILO_APP_ORIGIN=http://localhost:4190
# Public content API that Docs runs requests against. Demo mode runs its own. Run locally
# against Firebase, it defaults to http://127.0.0.1:4191 (`PORT=4191 npm run api`).
# MANTRILO_API_URL=https://api.mantrilo.com
PORT=4190
# Server only. Enables Vedic charts, daily Panchang, Guna Milan, chart images and places.
# MANTRILO_ASTROLOGY_API_KEY=
# Optional personal promo, configured on the console server only. Never commit its value.
# MANTRILO_UNLIMITED_PROMO='{"email":"developer@demo.invalid","code":"replace-with-a-random-code"}'
# For Firebase mode, configure these server-side values.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Optional email sign-in codes. Email and password works without this.
# RESEND_API_KEY=
# Use a domain verified in Resend; onboarding@resend.dev only reaches the Resend account owner.
# MANTRILO_EMAIL_FROM=Mantrilo <login@your-verified-domain>
# Phone sign-in is off unless this is true and the Firebase Phone provider is enabled.
# MANTRILO_PHONE_AUTH=true
# Google and Apple sign-in are off unless set to true and the provider is enabled in
# Firebase Authentication. Apple also needs a Services ID, key, and the Firebase auth
# handler (https://<FIREBASE_AUTH_DOMAIN>/__/auth/handler) as its return URL.
# MANTRILO_GOOGLE_AUTH=true
# MANTRILO_APPLE_AUTH=true
# Local only: user credentials can't sign sign-in tokens, so this service account signs them.
# MANTRILO_API_SIGNER=mantrilo-api@mantrilo.iam.gserviceaccount.com
# Initial bootstrap only. Supply securely via .env.local or Secret Manager.
# Never use an EXPO_PUBLIC_ variable for this password.
MANTRILO_INITIAL_ADMIN_PASSWORD=
# Optional local emulators only. Never set these in Cloud Run/production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Optional ADC key-file path; prefer gcloud ADC locally and workload identity on GCP.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/this/repo/service-account.json

# Stripe billing (Firebase mode only). Billing needs the secret key and all three prices.
# The webhook secret is optional, but without it a cancelled or unpaid plan only updates when
# the customer next opens Billing.
# Use sandbox values while testing. Never commit real values.
# MANTRILO_BILLING_MODE picks which entitlements this server reads and writes: "live" (the
# default, production) or "test" (local, with a sk_test_ key). Local and production share one
# Firestore, so test-mode plans are stored apart and never unlock production access. The
# secret key's mode must match, or billing stays off.
# MANTRILO_BILLING_MODE=test
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Optional non-default Stripe portal configuration for a Mantrilo-branded account.
# STRIPE_MANTRILO_PORTAL_CONFIGURATION=bpc_...
# Optional plan-specific Stripe promotion IDs for the STARTER99 first-month offer.
# STRIPE_STARTER_PROMOTION_ID=promo_...
# STRIPE_GROWTH_PROMOTION_ID=promo_...
# STRIPE_BUSINESS_PROMOTION_ID=promo_...
# Optional recurring INR prices for verified India workspaces.
# STRIPE_IN_PRICE_STARTER=price_...
# STRIPE_IN_PRICE_GROWTH=price_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_BUSINESS=price_...
# Optional yearly prices, about 20% off: annualTotal in shared/content-plans.json
# ($479.99, $1,429.99 and $3,829.99 a year) and shared/india-annual-totals.json (₹14,399 and ₹47,999).
# Without them, annual checkout shows as unavailable.
# STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_GROWTH_ANNUAL=price_...
# STRIPE_PRICE_BUSINESS_ANNUAL=price_...
# STRIPE_IN_PRICE_STARTER_ANNUAL=price_...
# STRIPE_IN_PRICE_GROWTH_ANNUAL=price_...

# Only needed by scripts/rewrite-descriptions.mjs.
# ANTHROPIC_API_KEY=

# Blog (server/blog.mjs). The service behind Firebase Hosting (MANTRILO_CONSOLE_BASE_PATH set)
# renders www.mantrilo.com/blog and reads the page layout from this origin's /blog-shell.
# MANTRILO_SITE_ORIGIN=https://www.mantrilo.com
