# Local demo: loopback-only, no real accounts or live billing. Resets on restart.
MANTRILO_MODE=demo
MANTRILO_APP_ORIGIN=http://localhost:4190
PORT=4190
# For Firebase mode, configure these server-side values.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Initial bootstrap only. Supply securely via .env.local or Secret Manager.
# Never use an EXPO_PUBLIC_ variable for this password.
MANTRILO_INITIAL_ADMIN_PASSWORD=
# Optional local emulators only. Never set these in Cloud Run/production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Optional ADC key-file path; prefer gcloud ADC locally and workload identity on GCP.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/this/repo/service-account.json
