rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Browser clients never access console records directly. Cloud Run uses IAM.
  // That includes `articles`: the blog is read and written only by the console service, which
  // checks the administrator itself, so no public or signed-in rule is needed.
  match /{document=**} { allow read, write: if false; }
 }
}
