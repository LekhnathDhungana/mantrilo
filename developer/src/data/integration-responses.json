      "verses": [
        {
          "number": 1,
          "sanskrit": "अहं वैश्वानरो भूत्वा प्राणिनां देहमाश्रितः\nप्राणापान समायुक्तः पचाम्यन्नं चतुर्विधम्",
          "transliteration": "ahaṃ vaiśvānaro bhūtvā prāṇināṃ dehamāśritaḥ\nprāṇāpāna samāyuktaḥ pacāmyannaṃ caturvidham",
          "translation": "I, having become the universal fire, residing in the bodies of living beings, and united with the inward and outward breaths, digest the four kinds of food (which is chewed, swallowed, licked and sucked)."
        }
      ]
    },
