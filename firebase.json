{
  "hosting": {
    "site": "mantrilo",
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "nginx-seo.conf"],
    "headers": [
      {
        "source": "/_expo/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/mantra-shloka-api",
        "destination": "/mantra-api",
        "type": 301
      }
    ]
  }
}
